object DepVersions {
  def mdoc = "2.3.6"
  def scala213 = "2.13.18"
  def scala3 = "3.3.8"
  def scalaJs = "1.22.0"
  def scalaNative = "0.5.12"

  def scala = Seq(scala213, "2.12.21", scala3)
}

object Deps {
  def macroParadise = mvn"org.scalamacros:::paradise:2.1.1"
  def pprint = mvn"com.lihaoyi::pprint::0.9.6"
  def utest = mvn"com.lihaoyi::utest::0.8.9"
}

trait VersionsMima extends Mima with PublishModule {
  def mimaPreviousVersions: T[Seq[String]] = Task.Input {
    val current = os.proc("git", "describe", "--tags", "--match", "v*")
      .call(cwd = BuildCtx.workspaceRoot)
      .out.trim()
    val cutOff = coursier.version.Version("0.4.0")
    os.proc("git", "tag", "-l")
      .call(cwd = BuildCtx.workspaceRoot)
      .out.lines()
      .filter(_ != current)
      .filter(_.startsWith("v"))
      .map(_.stripPrefix("v"))
      .map(coursier.version.Version(_))
      .filter(_ > cutOff)
      .sorted
      .map(_.repr)
  }
  // required if mimaPreviousVersions is empty
  def mimaPreviousArtifacts = Task {
    val versions = mimaPreviousVersions().distinct
    mill.api.Result.Success(
      versions.map(version =>
        mvn"${pomSettings().organization}:${artifactId()}:$version"
      )
    )
  }
}

trait VersionsPublishModule extends PublishModule with VersionsMima {
  // Publish almost empty javadoc JARs (only containing a manifest), rather
  // than spending time generating actual API documentation
  def docSources = Task { Seq.empty[PathRef] }

  def pomSettings = PomSettings(
    description = artifactName(),
    organization = "io.get-coursier",
    url = "https://github.com/coursier/versions",
    licenses = Seq(License.`Apache-2.0`),
    versionControl = VersionControl.github("coursier", "versions"),
    developers = Seq(
      Developer("alexarchambault", "Alex Archambault","https://github.com/alexarchambault")
    )
  )

  def publishVersion = Task {
    val state = VcsVersion.vcsState()
    if (state.commitsSinceLastTag > 0) {
      val versionOrEmpty = state.lastTag
        .filter(_ != "latest")
        .map(_.stripPrefix("v"))
        .flatMap { tag =>
          val idx = tag.lastIndexOf(".")
          if (idx >= 0)
            Some(tag.take(idx + 1) + (tag.drop(idx + 1).takeWhile(_.isDigit).toInt + 1).toString + "-SNAPSHOT")
          else None
        }
        .getOrElse("0.0.1-SNAPSHOT")
      Some(versionOrEmpty)
        .filter(_.nonEmpty)
        .getOrElse(state.format())
    } else
      state
        .lastTag
        .getOrElse(state.format())
        .stripPrefix("v")
  }
}

trait Versions extends Cross.Module[String] with ScalaModule with VersionsPublishModule {
  def artifactName = "versions"
  def scalaVersion = crossValue
  def mimaPreviousVersions = Task {
    import _root_.coursier.version.Version
    val previousVersions = super.mimaPreviousVersions()
    if (scalaVersion().startsWith("3.")) {
      val cutOff = Version("0.6.0")
      previousVersions
        .map(Version(_))
        .filter(_ >= cutOff)
        .map(_.repr)
    } else
      previousVersions
  }
  def mimaPreviousArtifacts = Task {
    val artifacts = super.mimaPreviousArtifacts()
    if (scalaVersion().startsWith("3.")) {
      val artifactId213 = artifactId().stripSuffix("_3") + "_2.13"
      val artifacts213 = super.mimaPreviousVersions().distinct.map(version =>
        mvn"${pomSettings().organization}:$artifactId213:$version"
      )
      artifacts ++ artifacts213
    } else
      artifacts
  }
  def scalacPluginMvnDeps = Task {
    val sv = scalaVersion()
    val scala212Plugins =
      if (sv.startsWith("2.12.")) Seq(Deps.macroParadise)
      else Nil
    super.scalacPluginMvnDeps() ++ scala212Plugins
  }
  def scalacOptions = Task {
    super.scalacOptions() ++ Seq(
      "-deprecation",
      "--release",
      "8"
    )
  }
  def sources = Task {
    val sv = scalaVersion()
    val extraSources =
      if (sv.startsWith("2.")) Seq(versions.shared.scala2Sources())
      else if (sv.startsWith("3.")) Seq(versions.shared.scala3Sources())
      else Nil
    super.sources() ++ Seq(versions.shared.sources()) ++ extraSources
  }

  def mimaBinaryIssueFilters = super.mimaBinaryIssueFilters() ++ Seq(
    // Additional abstract method on *sealed* trait
    ProblemFilter.exclude[ReversedMissingMethodProblem]("coursier.version.VersionCompatibility.minimumCompatibleVersion")
  ) ++ {
    val scala3ObjectFinalFilters =
      if (scalaVersion().startsWith("3."))
        Seq(
          "coursier.version.ConstraintReconciliation$Default$",
          "coursier.version.ConstraintReconciliation$Relaxed$",
          "coursier.version.ConstraintReconciliation$SemVer$",
          "coursier.version.ConstraintReconciliation$Strict$",
          "coursier.version.Latest$Integration$",
          "coursier.version.Latest$Release$",
          "coursier.version.Latest$Stable$",
          "coursier.version.Version$BigNumber$",
          "coursier.version.Version$BuildMetadata$",
          "coursier.version.Version$Max$",
          "coursier.version.Version$Min$",
          "coursier.version.Version$Number$",
          "coursier.version.Version$Tag$",
          "coursier.version.Version$Tokenizer$",
          "coursier.version.Version$Tokenizer$Dot$",
          "coursier.version.Version$Tokenizer$Hyphen$",
          "coursier.version.Version$Tokenizer$None$",
          "coursier.version.Version$Tokenizer$Plus$",
          "coursier.version.Version$Tokenizer$Underscore$",
          "coursier.version.VersionCompatibility$Always$",
          "coursier.version.VersionCompatibility$Default$",
          "coursier.version.VersionCompatibility$EarlySemVer$",
          "coursier.version.VersionCompatibility$PackVer$",
          "coursier.version.VersionCompatibility$SemVer$",
          "coursier.version.VersionCompatibility$SemVerSpec$",
          "coursier.version.VersionCompatibility$Strict$",
          "coursier.version.VersionConstraint$Eager$",
          "coursier.version.VersionConstraint$Lazy$",
          "coursier.version.internal.Compatibility$RichChar$"
        ).map(ProblemFilter.exclude[FinalClassProblem])
      else Nil
    val scala3SyntheticFilters =
      if (scalaVersion().startsWith("3."))
        Seq(
          ProblemFilter.exclude[DirectMissingMethodProblem](
            "coursier.version.ModuleMatchers.apply"
          ),
          ProblemFilter.exclude[DirectMissingMethodProblem](
            "coursier.version.ModuleMatcher.coursier$version$ModuleMatcher$$blobToPattern$default$2"
          )
        )
      else Nil
    scala3ObjectFinalFilters ++ scala3SyntheticFilters
  }
}

trait VersionsJvm extends Versions {

  object test extends ScalaTests {
    def mvnDeps = super.mvnDeps() ++ Seq(
      Deps.pprint,
      Deps.utest
    )
    def testFramework = "utest.runner.Framework"
    def sources = Task {
      super.sources() ++ Seq(versions.shared.testSources())
    }
  }
}

